import numpy as np

X = np.array([8000, 12000, 16000, 20000, 25000])
y = np.array([5000, 7000, 9000, 12000, 15000])

x_mean = X.mean()
y_mean = y.mean()

m = np.sum((X-x_mean)*(y-y_mean)) / np.sum((X-x_mean)**2)
b = y_mean - m*x_mean

car = 18000
price = m*car + b

print("POLIREDDY 192325056")
print("Predicted Car Price:", price)
