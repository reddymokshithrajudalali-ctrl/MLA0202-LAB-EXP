import numpy as np

# [Sepal Length, Sepal Width, Petal Length, Petal Width]
X = np.array([
    [5.1, 3.5, 1.4, 0.2],
    [4.9, 3.0, 1.4, 0.2],
    [5.0, 3.4, 1.5, 0.2],
    [6.4, 3.2, 4.5, 1.5],
    [6.9, 3.1, 4.9, 1.5],
    [6.5, 2.8, 4.6, 1.5],
    [6.3, 3.3, 6.0, 2.5],
    [5.8, 2.7, 5.1, 1.9],
    [7.1, 3.0, 5.9, 2.1]
])

# 0 = Setosa, 1 = Versicolor, 2 = Virginica
y = np.array([0, 0, 0, 1, 1, 1, 2, 2, 2])

# Test flower
test = np.array([5.9, 3.0, 4.2, 1.5])

# Calculate Euclidean distance
distance = np.sqrt(np.sum((X - test) ** 2, axis=1))

# K = 3
k = 3

# Find nearest flowers
nearest = np.argsort(distance)[:k]
print("Polireddy 192325056")
print("Nearest flowers:", nearest)

# Find majority class
classes = y[nearest]
prediction = np.bincount(classes).argmax()

names = ["Setosa", "Versicolor", "Virginica"]

print("Predicted Flower:", names[prediction])
